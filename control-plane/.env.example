# Control Plane Configuration
# Copy to .env and fill in values: cp .env.example .env

# Postgres
CP_DB_HOST=postgres
CP_DB_PORT=5432
CP_DB_NAME=fleet_monitor
CP_DB_USER=monitor
CP_DB_PASSWORD=CHANGE_ME_USE_RANDOM_STRING

# Control Plane Server
CP_PORT=9090
CP_API_KEY=CHANGE_ME_USE_GENERATE_SCRIPT

# Ports exposed to host (change if conflicts)
POSTGRES_HOST_PORT=5433
CP_HOST_PORT=9090
